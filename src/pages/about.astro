---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || data.date <= new Date());
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="博客文章 - Zoe's Blog" description="博客文章列表">
  <section class="blog-header">
    <h1>博客文章</h1>
    <p>记录思考与学习笔记。</p>
  </section>

  <section class="post-list">
    {
      posts.length > 0
        ? posts.map((post) => <PostCard post={post} />)
        : <p class="empty">还没有文章，敬请期待~ 🎀</p>
    }
  </section>
</BaseLayout>

<style>
  .blog-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .blog-header h1 {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--accent), var(--text-link));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .blog-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
  }
</style>
