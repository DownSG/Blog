---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIdx = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIdx < allPosts.length - 1 ? allPosts[currentIdx + 1] : null;
const nextPost = currentIdx > 0 ? allPosts[currentIdx - 1] : null;

const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} - 我的博客`} description={post.data.description}>
  <article class="article">
    <header class="article-header">
      <time datetime={post.data.date.toISOString()} class="article-date">
        {post.data.date.toISOString().split('T')[0]}
      </time>
      <h1>{post.data.title}</h1>
    </header>

    <div class="article-body prose">
      <Content />
    </div>

    {
      (prevPost || nextPost) && (
        <nav class="post-nav">
          {prevPost && (
            <a href={`/blog/${prevPost.id}`} class="post-nav-link prev">
              <span class="label">&larr; 上一篇</span>
              <span class="title">{prevPost.data.title}</span>
            </a>
          )}
          {nextPost && (
            <a href={`/blog/${nextPost.id}`} class="post-nav-link next">
              <span class="label">下一篇 &rarr;</span>
              <span class="title">{nextPost.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .article-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .article-date {
    color: var(--text-muted);
    font-size: 0.9rem;
    display: inline-block;
    background: var(--accent-soft);
    padding: 0.2rem 0.9rem;
    border-radius: 14px;
    margin-bottom: 0.8rem;
  }

  .article-header h1 {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.3;
    background: linear-gradient(135deg, var(--accent), var(--text-link));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .article-body {
    padding-bottom: 2rem;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1.5px solid var(--border);
    margin-top: 2rem;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    max-width: 45%;
    text-decoration: none;
    padding: 1rem 1.2rem;
    border-radius: var(--radius);
    border: 1.5px solid var(--border);
    background: var(--bg-card);
    transition: all 0.2s;
  }

  .post-nav-link:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 8px rgba(220, 140, 160, 0.1);
  }

  .post-nav-link.next {
    text-align: right;
    margin-left: auto;
  }

  .post-nav-link .label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .post-nav-link .title {
    color: var(--text-link);
    font-size: 0.95rem;
    margin-top: 0.2rem;
    font-weight: 500;
  }
</style>
